---
import { APPSTORE_URL, PLAYSTORE_URL } from '../data/storeLinks';
---

<header
  class="sticky top-0 z-50 w-full border-b border-hairline bg-white/90 backdrop-blur-[6px]"
>
  <div class="container-content flex h-16 items-center justify-between">
    <a href="/" aria-label="헤이보카 홈" class="inline-flex items-center">
      <img
        src="/images/logo_h.svg"
        alt="Hey, Voca!"
        width="106"
        height="25"
        class="h-[22px] w-auto select-none"
        loading="eager"
      />
    </a>

    <nav aria-label="주요 메뉴" class="hidden items-center gap-7 md:flex">
      <a href="#how" class="btn-quiet">학습 방식</a>
      <a href="#demo" class="btn-quiet">학습 흐름</a>
      <a href="#achievements" class="btn-quiet">업적</a>
      <a href="#download" class="btn-quiet">다운로드</a>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={APPSTORE_URL}
        data-store="app_store"
        data-location="header"
        target="_blank"
        rel="noopener"
        aria-label="App Store에서 받기"
        class="hidden text-body-sm font-medium text-sub hover:text-ink md:inline-flex"
      >
        iOS
      </a>
      <a
        href={PLAYSTORE_URL}
        data-store="play_store"
        data-location="header"
        target="_blank"
        rel="noopener"
        aria-label="Google Play에서 받기"
        class="hidden text-body-sm font-medium text-sub hover:text-ink md:inline-flex"
      >
        Android
      </a>
      <a
        id="header-get-app"
        href="/#download"
        data-appstore={APPSTORE_URL}
        data-playstore={PLAYSTORE_URL}
        class="btn-primary !px-5 !py-2 text-body-sm">앱 받기</a>
    </div>
  </div>
</header>

<script>
  // '앱 받기' 버튼: 모바일은 OS 감지 후 해당 스토어로 직접 연결,
  // 데스크톱/기타는 기본 href(/#download — 홈 다운로드 섹션) 유지.
  // 인앱 웹뷰에서 target=_blank가 차단될 수 있어 모바일은 같은 탭으로 이동.
  const btn = document.getElementById('header-get-app');
  if (btn) {
    const ua = navigator.userAgent || '';
    const isIOS = /iPad|iPhone|iPod/.test(ua) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const isAndroid = /Android/.test(ua);
    if (isIOS) {
      btn.setAttribute('href', btn.dataset.appstore);
      btn.setAttribute('data-store', 'app_store');
      btn.setAttribute('data-location', 'header_get_app');
    } else if (isAndroid) {
      btn.setAttribute('href', btn.dataset.playstore);
      btn.setAttribute('data-store', 'play_store');
      btn.setAttribute('data-location', 'header_get_app');
    }
  }
</script>
