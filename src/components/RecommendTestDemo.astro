---
// 복습 = 물 주기 — 실제 앱 녹화 영상 + 문제 유형·난이도 사실 패널.
// 문제 유형 라벨은 heyvoca_front src/plugins/questionTypes/index.js(학습용 12종, 만나기·글자 제외) 기준.
import AppVideoShowcase from './demo/AppVideoShowcase.tsx';

const clips = [
  {
    id: 'combo-chain',
    label: '농장 돌보기',
    caption: '맞히면 XP가 쌓이고, 작물이 다음 단계로 자라요.',
    src: '/videos/combo-chain.mp4',
    poster: '/videos/combo-chain-poster.jpg',
  },
  {
    id: 'dict-to-test',
    label: '사전에서 담기',
    caption: '사전에서 찾은 단어를 단어장에 담고 바로 학습해요.',
    src: '/videos/dict-to-test.mp4',
    poster: '/videos/dict-to-test-poster.jpg',
  },
];

const groups = [
  {
    title: '단어',
    items: ['사지선다 영→한', '뜻 보고 단어 고르기', '듣고 고르기', '카드 맞추기', '듣고 카드 맞추기', '단어 쓰기'],
  },
  {
    title: '문장',
    items: ['빈칸 고르기', '빈칸 쓰기', '문장 조립(부분)', '문장 조립', '해석 조립', '듣고 받아쓰기'],
  },
];

const points = [
  {
    title: '난이도 사다리',
    desc: '작물이 자랄수록 더 어려운 유형이 열려요. 맞히면 한 칸 오르고, 틀리면 한 칸 내려가요.',
  },
  {
    title: '내 수준에 맞는 예문',
    desc: '예문은 CEFR A1~C2 수준으로 나뉘어 있어, 지금 수준에 맞는 문장으로 출제돼요.',
  },
];
---

<section id="recommend-test" class="section bg-surface" aria-labelledby="recommend-test-h2">
  <div class="container-content">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow">
        <span class="h-1.5 w-1.5 rounded-full bg-primary-500"></span>
        복습 = 물 주기
      </span>
      <h2
        id="recommend-test-h2"
        class="mt-6 text-balance text-[36px] font-bold leading-[1.12] tracking-tight text-ink md:text-display-lg lg:text-display-xl"
      >
        목마른 작물부터,<br />
        여러 방식으로 물 주기.
      </h2>
      <p class="mt-6 max-w-prose text-body-lg text-sub text-pretty">
        복습할 때가 된 단어는 목마른 작물이 돼요. 12가지 문제 유형이 섞여 나오고,
        맞히면 XP가 쌓여 작물이 씨앗에서 당근까지 자랍니다.
      </p>
    </div>

    <div class="mt-14 grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-20">
      <div data-reveal>
        <AppVideoShowcase clips={clips} ariaLabel="복습 영상" client:visible />
      </div>

      <div class="flex min-w-0 flex-col gap-6" data-reveal>
        <div class="card p-6">
          <p class="text-caption font-medium uppercase tracking-[0.12em] text-mute">문제 유형 12가지</p>
          {groups.map((g) => (
            <div class="mt-5">
              <p class="text-body font-semibold text-ink">{g.title}</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {g.items.map((it) => (
                  <li class="rounded-full bg-primary-100 px-3 py-1 text-body-sm font-medium text-primary-600">{it}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        {points.map((p) => (
          <div class="card p-6">
            <p class="text-body font-semibold text-ink">{p.title}</p>
            <p class="mt-2 text-body-sm text-sub text-pretty">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
