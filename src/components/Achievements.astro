---
// 실서비스 업적 6종 — heyvoca_front components/achievement/achievementMeta.js ACHIEVEMENT_TYPES
// 레벨이 오를수록 메달이 동 → 은 → 금 → 무지개로 바뀐다(achievementTier).
const kings = [
  { src: '/images/AttendanceKing.png', name: '출석왕', desc: '매일 학습하러 오면' },
  { src: '/images/PerseveranceKing.png', name: '끈기왕', desc: '연속 학습을 이어가면' },
  { src: '/images/NoryeokKing.png', name: '노력왕', desc: '학습을 거듭할수록' },
  { src: '/images/MemorizedKing.png', name: '암기왕', desc: '연속으로 맞힌 최고 콤보' },
  { src: '/images/ReadingKing.png', name: '독서왕', desc: '서점 단어장을 담을수록' },
  { src: '/images/InviteKing.png', name: '초대왕', desc: '친구를 초대하면' },
];
---

<section id="achievements" class="section bg-white" aria-labelledby="achievements-h2">
  <div class="container-content">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <span class="eyebrow justify-center">
        <span class="h-1.5 w-1.5 rounded-full bg-primary-500"></span>
        업적
      </span>
      <h2
        id="achievements-h2"
        class="mt-6 text-balance text-[36px] font-bold leading-[1.12] tracking-tight text-ink md:text-display-lg lg:text-display-xl"
      >
        당신의 학습엔,<br />
        <span class="font-display text-primary-500">왕좌</span>가 여섯 자리 있습니다.
      </h2>
      <p class="mt-6 text-body-lg text-sub text-pretty">
        출석 · 끈기 · 노력 · 암기 · 독서 · 초대 — 레벨이 오를 때마다 보석을 받고, 메달은 동 · 은 · 금 · 무지개로 빛나요.
      </p>
    </div>

    <ul
      class="mt-16 grid grid-cols-3 gap-x-6 gap-y-10 md:grid-cols-6 lg:gap-x-4"
      data-reveal-stagger
      data-stagger-ms="80"
    >
      {kings.map((k) => (
        <li class="flex flex-col items-center text-center">
          <img
            src={k.src}
            alt=""
            width="180"
            height="180"
            loading="lazy"
            decoding="async"
            class="h-auto w-[120px] select-none transition-transform duration-300 hover:-translate-y-1 lg:w-[128px]"
          />
          <p class="mt-3 font-display text-heading-md text-ink">{k.name}</p>
          <p class="mt-1 text-caption text-mute">{k.desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
