---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Trust from '../components/Trust.astro';
import AppTour from '../components/AppTour.astro';
import Problem from '../components/Problem.astro';
import Solution from '../components/Solution.astro';
import InteractiveDemo from '../components/InteractiveDemo.astro';
import RecommendTestDemo from '../components/RecommendTestDemo.astro';
import OcrSimulation from '../components/OcrSimulation.astro';
import ImportFormats from '../components/ImportFormats.astro';
import DictionarySection from '../components/DictionarySection.astro';
import Achievements from '../components/Achievements.astro';
import Proof from '../components/Proof.astro';
import DownloadCTA from '../components/DownloadCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="헤이보카 (Hey, Voca!)"
  description="외운 단어가 사라지기 전에. 데이터가 다음 복습 시점을 정해주고, 외운 단어가 당근 농장의 작물로 자라는 영어·일본어 단어 학습 앱 헤이보카(Hey, Voca!). iOS · Android, 무료."
  path="/"
>
  <Header />
  <main>
    <Hero />
    <Trust />
    <AppTour />
    <Problem />
    <Solution />
    <InteractiveDemo />
    <RecommendTestDemo />
    <OcrSimulation />
    <ImportFormats />
    <DictionarySection />
    <Achievements />
    <Proof />
    <DownloadCTA />
  </main>
  <Footer />
</BaseLayout>
